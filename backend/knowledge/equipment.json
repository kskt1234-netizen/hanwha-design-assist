{
  "domain": "equipment",
  "name": "설비관리",
  "chunks": [
    {"type": "term", "title": "설비", "content": "생산이나 운영에 쓰이는 기계 장치. 설비코드, 설비명, 모델, 설치위치, 도입일, 상태를 가진다. 동의어: 장비, 기계, 자산."},
    {"type": "term", "title": "예방점검", "content": "고장을 막기 위해 정해진 주기로 설비를 점검하는 것. 점검항목, 주기, 다음 점검일을 관리한다."},
    {"type": "term", "title": "고장", "content": "설비가 정상 기능을 못하는 상태. 고장일시, 증상, 원인, 조치내용, 정지시간을 기록한다."},
    {"type": "term", "title": "작업지시", "content": "점검이나 수리를 담당자에게 배정하는 지시서. 작업유형, 담당자, 계획일, 완료일, 상태를 가진다. 동의어: 워크오더."},
    {"type": "term", "title": "MTBF", "content": "평균 고장 간격. 가동시간 합계를 고장 횟수로 나눈 값으로 설비 신뢰성 지표다."},
    {"type": "term", "title": "예비품", "content": "수리에 쓰이는 교체 부품. 부품코드, 부품명, 재고수량을 관리한다. 동의어: 스페어파트, 소모품."},
    {"type": "rule", "title": "점검 일정 규칙", "content": "예방점검 계획은 설비별 점검주기(일 단위)로 다음 점검일을 계산한다. 점검 결과가 이상이면 작업지시를 자동 생성한다."},
    {"type": "rule", "title": "설비 이력 보관", "content": "고장, 점검, 수리 이력은 설비 폐기 후에도 보관한다. 설비 상태는 가동, 정지, 수리중, 폐기 중 하나다."},
    {"type": "naming", "title": "명명 규칙", "content": "테이블과 컬럼은 영문 소문자 snake_case. PK는 id, FK는 참조테이블명_id. 일자는 _date, 일시는 _at 접미사를 쓴다."},
    {"type": "pattern", "title": "설비 엔티티", "content": "설비 마스터 테이블 equipment.",
     "payload": {"keywords": ["설비", "장비", "기계", "자산"], "table": "equipment", "logical": "설비",
       "attributes": [["id","설비ID","BIGINT",null,false,true,false],["equipment_code","설비코드","VARCHAR",30,false,false,true],["equipment_name","설비명","VARCHAR",200,false,false,false],["model","모델","VARCHAR",100,true,false,false],["location","설치위치","VARCHAR",200,true,false,false],["installed_date","도입일","DATE",null,true,false,false],["status","상태","VARCHAR",20,false,false,false]],
       "references": []}},
    {"type": "pattern", "title": "점검계획 엔티티", "content": "예방점검 계획 테이블 inspection_plan.",
     "payload": {"keywords": ["점검", "예방점검", "점검계획", "주기"], "table": "inspection_plan", "logical": "점검계획",
       "attributes": [["id","점검계획ID","BIGINT",null,false,true,false],["equipment_id","설비ID","BIGINT",null,false,false,false],["check_item","점검항목","VARCHAR",200,false,false,false],["cycle_days","점검주기(일)","INTEGER",null,false,false,false],["next_date","다음점검일","DATE",null,false,false,false]],
       "references": [{"to": "equipment", "fk": "equipment_id"}]}},
    {"type": "pattern", "title": "점검결과 엔티티", "content": "점검 수행 결과 테이블 inspection_result.",
     "payload": {"keywords": ["점검 결과", "점검결과", "점검 수행", "이상"], "table": "inspection_result", "logical": "점검결과",
       "attributes": [["id","점검결과ID","BIGINT",null,false,true,false],["inspection_plan_id","점검계획ID","BIGINT",null,false,false,false],["inspected_at","점검일시","TIMESTAMP",null,false,false,false],["result","결과(정상/이상)","VARCHAR",10,false,false,false],["note","비고","TEXT",null,true,false,false],["inspector_id","점검자ID","BIGINT",null,true,false,false]],
       "references": [{"to": "inspection_plan", "fk": "inspection_plan_id"}, {"to": "user_account", "fk": "inspector_id"}]}},
    {"type": "pattern", "title": "고장 엔티티", "content": "고장 접수와 조치 이력 테이블 failure_report.",
     "payload": {"keywords": ["고장", "장애", "수리", "정지"], "table": "failure_report", "logical": "고장이력",
       "attributes": [["id","고장ID","BIGINT",null,false,true,false],["equipment_id","설비ID","BIGINT",null,false,false,false],["occurred_at","발생일시","TIMESTAMP",null,false,false,false],["symptom","증상","TEXT",null,false,false,false],["cause","원인","TEXT",null,true,false,false],["action_taken","조치내용","TEXT",null,true,false,false],["downtime_minutes","정지시간(분)","INTEGER",null,true,false,false]],
       "references": [{"to": "equipment", "fk": "equipment_id"}]}},
    {"type": "pattern", "title": "작업지시 엔티티", "content": "점검과 수리 작업지시 테이블 work_order.",
     "payload": {"keywords": ["작업지시", "워크오더", "배정", "담당자"], "table": "work_order", "logical": "작업지시",
       "attributes": [["id","작업지시ID","BIGINT",null,false,true,false],["equipment_id","설비ID","BIGINT",null,false,false,false],["work_type","작업유형","VARCHAR",20,false,false,false],["assignee_id","담당자ID","BIGINT",null,true,false,false],["planned_date","계획일","DATE",null,false,false,false],["completed_date","완료일","DATE",null,true,false,false],["status","상태","VARCHAR",20,false,false,false]],
       "references": [{"to": "equipment", "fk": "equipment_id"}, {"to": "user_account", "fk": "assignee_id"}]}},
    {"type": "pattern", "title": "예비품 엔티티", "content": "예비품 마스터 테이블 spare_part.",
     "payload": {"keywords": ["예비품", "부품", "스페어", "소모품"], "table": "spare_part", "logical": "예비품",
       "attributes": [["id","예비품ID","BIGINT",null,false,true,false],["part_code","부품코드","VARCHAR",30,false,false,true],["part_name","부품명","VARCHAR",200,false,false,false],["stock_qty","재고수량","INTEGER",null,false,false,false]],
       "references": []}},
    {"type": "pattern", "title": "사용자 엔티티", "content": "시스템 사용자와 권한 테이블 user_account.",
     "payload": {"keywords": ["사용자", "로그인", "권한", "담당자", "점검자"], "table": "user_account", "logical": "사용자",
       "attributes": [["id","사용자ID","BIGINT",null,false,true,false],["login_id","로그인ID","VARCHAR",50,false,false,true],["user_name","이름","VARCHAR",50,false,false,false],["role","권한","VARCHAR",20,false,false,false],["password_hash","비밀번호해시","VARCHAR",200,false,false,false]],
       "references": []}}
  ]
}
