{
  "domain": "inventory",
  "name": "재고관리",
  "chunks": [
    {"type": "term", "title": "품목", "content": "재고로 관리되는 물품 단위. 품목코드, 품목명, 규격, 단위, 안전재고 수량을 가진다. 동의어: 자재, 제품, 아이템, SKU."},
    {"type": "term", "title": "창고", "content": "품목을 보관하는 물리적 장소. 창고코드, 창고명, 위치를 가진다. 동의어: 보관소, 로케이션."},
    {"type": "term", "title": "거래처", "content": "입고 공급처 또는 출고 납품처. 거래처코드, 거래처명, 사업자등록번호, 연락처를 가진다. 동의어: 공급업체, 협력사, 고객사."},
    {"type": "term", "title": "입고", "content": "구매하거나 생산된 품목이 창고로 들어오는 것. 입고일, 수량, 공급 거래처를 기록한다."},
    {"type": "term", "title": "출고", "content": "판매, 생산투입, 이동을 위해 품목이 창고에서 나가는 것. 출고일, 수량, 납품처를 기록한다."},
    {"type": "term", "title": "안전재고", "content": "결품을 막기 위해 항상 유지해야 하는 최소 재고 수량. 현재고가 안전재고 미만이면 발주 알림을 보낸다."},
    {"type": "term", "title": "재고실사", "content": "장부상 재고와 실제 재고를 비교하는 작업. 실사일, 장부수량, 실사수량, 차이수량을 기록한다."},
    {"type": "rule", "title": "재고 수량 갱신 규칙", "content": "현재고는 입고 시 증가하고 출고 시 감소한다. 출고 수량이 현재고보다 크면 출고할 수 없다. 모든 입출고는 이력으로 남기고 삭제하지 않는다."},
    {"type": "rule", "title": "재고 이력 보관", "content": "입출고 이력과 실사 이력은 감사 목적상 최소 5년 보관한다. 수정 시 원본을 변경하지 않고 정정 거래를 추가한다."},
    {"type": "naming", "title": "명명 규칙", "content": "테이블과 컬럼은 영문 소문자 snake_case. PK는 id, FK는 참조테이블명_id. 코드 컬럼은 _code, 수량은 _qty 또는 quantity, 일자는 _date, 일시는 _at 접미사를 쓴다."},
    {"type": "pattern", "title": "품목 엔티티", "content": "품목 마스터 테이블 item. 품목 등록, 수정, 조회 기능에 사용.",
     "payload": {"keywords": ["품목", "자재", "제품", "아이템", "SKU"], "table": "item", "logical": "품목",
       "attributes": [["id","품목ID","BIGINT",null,false,true,false],["item_code","품목코드","VARCHAR",30,false,false,true],["item_name","품목명","VARCHAR",200,false,false,false],["spec","규격","VARCHAR",200,true,false,false],["unit","단위","VARCHAR",20,false,false,false],["safety_stock_qty","안전재고수량","INTEGER",null,false,false,false],["created_at","등록일시","TIMESTAMP",null,false,false,false]],
       "references": []}},
    {"type": "pattern", "title": "창고 엔티티", "content": "창고 마스터 테이블 warehouse. 창고 등록, 조회에 사용.",
     "payload": {"keywords": ["창고", "보관소", "로케이션"], "table": "warehouse", "logical": "창고",
       "attributes": [["id","창고ID","BIGINT",null,false,true,false],["warehouse_code","창고코드","VARCHAR",30,false,false,true],["warehouse_name","창고명","VARCHAR",100,false,false,false],["location","위치","VARCHAR",200,true,false,false]],
       "references": []}},
    {"type": "pattern", "title": "거래처 엔티티", "content": "거래처 마스터 테이블 partner. 공급처와 납품처 관리.",
     "payload": {"keywords": ["거래처", "공급업체", "공급처", "협력사", "고객사", "납품처"], "table": "partner", "logical": "거래처",
       "attributes": [["id","거래처ID","BIGINT",null,false,true,false],["partner_code","거래처코드","VARCHAR",30,false,false,true],["partner_name","거래처명","VARCHAR",200,false,false,false],["business_no","사업자등록번호","VARCHAR",20,true,false,false],["phone","연락처","VARCHAR",30,true,false,false]],
       "references": []}},
    {"type": "pattern", "title": "재고 엔티티", "content": "품목별 창고별 현재고 테이블 inventory.",
     "payload": {"keywords": ["재고", "현재고", "재고현황", "재고 조회", "안전재고"], "table": "inventory", "logical": "재고",
       "attributes": [["id","재고ID","BIGINT",null,false,true,false],["item_id","품목ID","BIGINT",null,false,false,false],["warehouse_id","창고ID","BIGINT",null,false,false,false],["quantity","현재고수량","INTEGER",null,false,false,false],["updated_at","갱신일시","TIMESTAMP",null,false,false,false]],
       "references": [{"to": "item", "fk": "item_id"}, {"to": "warehouse", "fk": "warehouse_id"}]}},
    {"type": "pattern", "title": "입출고 이력 엔티티", "content": "입고와 출고 거래 이력 테이블 stock_transaction.",
     "payload": {"keywords": ["입고", "출고", "입출고", "이력"], "table": "stock_transaction", "logical": "입출고이력",
       "attributes": [["id","입출고ID","BIGINT",null,false,true,false],["transaction_type","구분(IN/OUT)","VARCHAR",10,false,false,false],["item_id","품목ID","BIGINT",null,false,false,false],["warehouse_id","창고ID","BIGINT",null,false,false,false],["partner_id","거래처ID","BIGINT",null,true,false,false],["quantity","수량","INTEGER",null,false,false,false],["transaction_date","거래일자","DATE",null,false,false,false],["created_by","등록자ID","BIGINT",null,true,false,false]],
       "references": [{"to": "item", "fk": "item_id"}, {"to": "warehouse", "fk": "warehouse_id"}, {"to": "partner", "fk": "partner_id"}, {"to": "user_account", "fk": "created_by"}]}},
    {"type": "pattern", "title": "재고실사 엔티티", "content": "재고실사 결과 테이블 stock_count.",
     "payload": {"keywords": ["실사", "재고실사", "차이"], "table": "stock_count", "logical": "재고실사",
       "attributes": [["id","실사ID","BIGINT",null,false,true,false],["item_id","품목ID","BIGINT",null,false,false,false],["warehouse_id","창고ID","BIGINT",null,false,false,false],["count_date","실사일자","DATE",null,false,false,false],["book_qty","장부수량","INTEGER",null,false,false,false],["actual_qty","실사수량","INTEGER",null,false,false,false]],
       "references": [{"to": "item", "fk": "item_id"}, {"to": "warehouse", "fk": "warehouse_id"}]}},
    {"type": "pattern", "title": "사용자 엔티티", "content": "시스템 사용자와 권한 테이블 user_account.",
     "payload": {"keywords": ["사용자", "로그인", "권한", "담당자"], "table": "user_account", "logical": "사용자",
       "attributes": [["id","사용자ID","BIGINT",null,false,true,false],["login_id","로그인ID","VARCHAR",50,false,false,true],["user_name","이름","VARCHAR",50,false,false,false],["role","권한","VARCHAR",20,false,false,false],["password_hash","비밀번호해시","VARCHAR",200,false,false,false]],
       "references": []}}
  ]
}
